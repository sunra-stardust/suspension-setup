    <!-- Basics cards (§10). First card per Change 01 §7. -->
    <string name="basics_clicks_title">Turn direction and counting</string>
    <string name="basics_clicks_row_cw_primary">Clockwise = close</string>
    <string name="basics_clicks_row_cw_secondary_1">Number goes down</string>
    <string name="basics_clicks_row_cw_secondary_2">Compression firmer · rebound slower</string>
    <string name="basics_clicks_row_ccw_primary">Counter-clockwise = open</string>
    <string name="basics_clicks_row_ccw_secondary_1">Number goes up</string>
    <string name="basics_clicks_row_ccw_secondary_2">Compression softer · rebound faster</string>
    <string name="basics_clicks_body_1">The number shows how many clicks the adjuster is open from its closed stop. 0 means fully closed.</string>
    <string name="basics_clicks_body_2">To count: turn clockwise to the soft stop, never force it, then turn counter-clockwise and count the clicks.</string>
    <string name="basics_clicks_body_3">Arrows show the turn direction at the dial. Plus and minus only change the number.</string>
    <string name="basics_clicks_body_4">Shock preload ring: clockwise = more clicks = more preload = less sag.</string>

    <string name="basics_order_title">Order</string>
    <string name="basics_order_step_1">Everything to the middle — that\'s your zero point</string>
    <string name="basics_order_step_2">Rear spring rate, front air pressure</string>
    <string name="basics_order_step_3">Measure sag, correct it, measure again</string>
    <string name="basics_order_step_4">Rebound</string>
    <string name="basics_order_step_5" translatable="false">LSC</string>
    <string name="basics_order_step_6" translatable="false">HSC</string>
    <string name="basics_order_footer">Changing the spring rate later means re-tuning everything. One change per ride.</string>

    <string name="basics_sag_title">Measuring sag</string>
    <string name="basics_sag_fork">Fork: push the O-ring against the seal, get off, measure the distance.</string>
    <string name="basics_sag_shock">Shock (coil): eye-to-eye length unloaded and loaded, the difference is sag.</string>
    <string name="basics_sag_footer">Always standing in the attack position, with your pack. Bounce a few times, then stand still. Measure two or three times.</string>

    <!-- Target sag: mm are computed from the selected fork travel / shock stroke. -->
    <string name="basics_targets_title">Targets</string>
    <string name="basics_targets_row_1_label">Fork bike park</string>
    <string name="basics_targets_row_2_label">Fork standard</string>
    <string name="basics_targets_row_3_label">Fork comfortable</string>
    <string name="basics_targets_row_4_label">Shock climbing</string>
    <string name="basics_targets_row_5_label">Shock descending</string>
    <string name="basics_targets_row_6_label">Spring too soft from</string>
    <string name="basics_targets_value" translatable="false">%1$s mm · %2$d %%</string>
    <string name="basics_targets_footer">Fox recommends 15–20 % sag on the fork and about 30 % on a coil shock — the fork deliberately runs less sag. That\'s normal.</string>

    <string name="basics_temp_title">Temperature</string>
    <string name="basics_temp_setup">In Setup you set the riding temperature (base 20 °C). Air pressure and tires then show the fill pressure at 20 °C that reaches the target at that temperature — if you pump up outside, take the target from the hint. Clicks follow the oil: cold = opened further, warm = closed further.</string>
    <string name="basics_temp_bullet_1">Cold oil damps more — winter and summer are 1–3 clicks apart</string>
    <string name="basics_temp_bullet_2">Air spring: about 4 % less pressure per 10 °C colder — at 110 psi, 20 → 0 °C is about 8 psi</string>
    <string name="basics_temp_bullet_3">A rear coil spring stays constant</string>
    <string name="basics_temp_bullet_4">1.8 bar at 20 °C is only about 1.6 bar at 0 °C</string>
    <string name="basics_temp_footer">Check tire and fork pressure at riding temperature, not in the warm workshop. Never judge on a cold bike.</string>

    <string name="basics_compression_title">What compression damping can\'t do</string>
    <string name="basics_compression_body">Prevent bottoming out. That\'s the job of volume spacers up front (with correct sag) and, on a coil shock, the spring rate — preload only fine-tunes sag. Closing HSC makes the suspension harsher on edges but doesn\'t replace progression.</string>

