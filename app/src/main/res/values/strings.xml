    <string name="setup_footer_note">Where a manufacturer chart exists, air pressure and fork rebound come from it — matched to your weight. Temperature and weight only change values you haven\'t adjusted yourself: your own changes stay put. All other click values are starting points; the factory recommendation for your unit comes from the manufacturer (Fox: 4-digit ID on ridefox.com).</string>

    <string name="diagnose_search_placeholder">Search symptom — e.g. nervous, dives, bucks</string>

    <!-- Diagnose actions: "Close …" = clockwise, "Open …" = counter-clockwise
         (DiagnoseDirectionConsistencyTest). -->
    <string name="diag_symptom_1">Dives hard under braking</string>
    <string name="diag_action_1">Close fork LSC</string>
    <string name="diag_explanation_1">More resistance to slow compression keeps the geometry stable.</string>

    <string name="diag_symptom_2">Vague in berms, no support</string>
    <string name="diag_action_2">Close LSC (front and rear)</string>
    <string name="diag_explanation_2">The low-speed circuit carries pumping and cornering loads.</string>

    <string name="diag_symptom_3">Buzzing hands, no grip on small stuff</string>
    <string name="diag_action_3">Open fork LSC</string>
    <string name="diag_explanation_3">More sensitive response in the first third of travel.</string>

    <string name="diag_symptom_4">Nervous over fast small hits</string>
    <string name="diag_action_4">Open fork HSC</string>
    <string name="diag_explanation_4">High speed means how fast the suspension moves, not how fast you ride.</string>

    <string name="diag_symptom_5">Hard edges hammer through</string>
    <string name="diag_action_5">Open HSC</string>
    <string name="diag_explanation_5">Oil flows faster, the hit is absorbed instead of passed on.</string>

    <string name="diag_symptom_6">Skips over root sections, never settles</string>
    <string name="diag_action_6">Open shock HSC</string>
    <string name="diag_explanation_6">The rear can\'t keep up with repeated hits.</string>

    <string name="diag_symptom_7">Bobs when pedaling, sags under motor load</string>
    <string name="diag_action_7">Close shock LSC</string>
    <string name="diag_explanation_7">Motor torque acts like constant pedaling.</string>

    <string name="diag_symptom_8">Bucks, the rear kicks up</string>
    <string name="diag_action_8">Close shock LSR</string>
    <string name="diag_explanation_8">The spring gives its energy back too fast.</string>

    <string name="diag_symptom_9">Bounces after big landings</string>
    <string name="diag_action_9">Close HSR</string>
    <string name="diag_explanation_9">Slows fast extension after a hard hit.</string>

    <string name="diag_symptom_10">Feels dead, stays low through repeated hits</string>
    <string name="diag_action_10">Open LSR and HSR</string>
    <string name="diag_explanation_10">The travel isn\'t there for the next obstacle.</string>

    <string name="diag_symptom_11">Fork bottoms out</string>
    <string name="diag_action_11">Check sag, then add one volume spacer</string>
    <string name="diag_explanation_11">Fox: once sag is right, volume spacers set bottom-out resistance. Only add air pressure as far as sag stays in the target range.</string>

    <string name="diag_symptom_12">Shock bottoms out</string>
    <string name="diag_action_12">Stiffer spring</string>
    <string name="diag_explanation_12">Preload is only for fine-tuning sag (Fox: max 2 turns) and doesn\'t replace spring rate.</string>

    <string name="diag_symptom_13">Sag over 32 % despite preload</string>
    <string name="diag_action_13">Next stiffer spring</string>
    <string name="diag_explanation_13">Fox: if preload can\'t reach the sag, you need a different spring.</string>

    <string name="diag_symptom_14">Front wheel lifts on steep climbs</string>
    <string name="diag_action_14">Flip chip to High</string>
    <string name="diag_explanation_14">Steeper seat angle, more weight over the front.</string>

    <string name="diag_symptom_15">Pedals strike the ground</string>
    <string name="diag_action_15">Flip chip to High</string>
    <string name="diag_explanation_15">5 mm more bottom bracket height.</string>

    <string name="diag_symptom_16">No grip on wet roots</string>
    <string name="diag_action_16">Tire pressure 0.1 bar lower</string>
    <string name="diag_explanation_16">Bigger contact patch, the casing wraps around edges better.</string>

    <string name="diag_symptom_17">Dull clunk on hard edges</string>
    <string name="diag_action_17">Rear insert instead of more pressure</string>
    <string name="diag_explanation_17">Rim contact. More pressure costs grip.</string>

    <string name="diag_symptom_18">Suspension dull and sluggish in winter</string>
    <string name="diag_action_18">Open LSC and HSC 1–2 clicks</string>
    <string name="diag_explanation_18">Cold oil is thicker and damps more.</string>

    <string name="diag_symptom_19">Fork sits lower in winter</string>
    <string name="diag_action_19">Set pressure again at riding temperature</string>
    <string name="diag_explanation_19">Air pressure follows absolute temperature: at about 110 psi, 20 → 0 °C costs roughly 8 psi.</string>

